# Copy to .env and fill in real values. .env is git-ignored — NEVER commit real keys.
# Any key seen in a commit, screenshot, or shared artifact must be considered exposed and rotated.

# ---------------------------------------------------------------------------
# Hunar Voice AI  (voice/conversation execution — single provider)
# Docs: https://api.voice.hunar.ai/docs/external/
# Auth: sent as the `X-API-Key` request header.
# ---------------------------------------------------------------------------
HUNAR_API_KEY=
HUNAR_API_BASE_URL=https://api.voice.hunar.ai/external/v1
# Shared secret(s) used to validate inbound Hunar webhook signatures (HMAC-SHA256).
HUNAR_WEBHOOK_SIGNING_KEY=
# Hunar agent used for AI stages with no explicit stage-level agent (from GET /agents/).
HUNAR_DEFAULT_AGENT_ID=
# Safety switch — real outbound calls are placed ONLY when this is true AND a key is set.
# Leave 0 unless you intend to dial real numbers.
HUNAR_LIVE_CALLS_ENABLED=0
# Celery: 1 runs tasks inline (no worker needed) — dev default. Set 0 + run a worker in prod.
CELERY_TASK_ALWAYS_EAGER=1

# ---------------------------------------------------------------------------
# People Search  (multi-provider — pick one active provider; others pluggable)
# Providers from the assignment: Apollo.io, People Data Labs (PDL), Proxycurl, Coresignal.
# ---------------------------------------------------------------------------
PEOPLE_SEARCH_PROVIDER=apollo        # apollo | pdl | proxycurl | coresignal
APOLLO_API_KEY=
PDL_API_KEY=
PROXYCURL_API_KEY=
CORESIGNAL_API_KEY=

# ---------------------------------------------------------------------------
# Platform LLM  (product intelligence only: JD understanding, role classification,
# draft workflow/rubric generation — never candidate conversation)
# Uses Claude (Anthropic). Set an Anthropic API key (sk-ant-...) to enable real JD
# extraction with Claude Haiku; leave blank to use the deterministic offline stub.
# ---------------------------------------------------------------------------
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Infrastructure (match compose.yaml defaults for local dev)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://recruitment:recruitment@localhost:5432/recruitment
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth (server-side session cookies)
# ---------------------------------------------------------------------------
# Comma-separated allowed browser origins (credentialed CORS — cannot be "*").
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=session
# MUST be 1 (True) in production so the cookie is only sent over HTTPS. 0 for local HTTP dev.
SESSION_COOKIE_SECURE=0
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
